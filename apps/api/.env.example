# API runtime config.
PORT=8088
HOST=0.0.0.0
WEB_BASE_URL="http://localhost:3000"
# Same PostgreSQL as packages/db (docker-compose host port 5433; bound to localhost).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/prograds?schema=public"
# Optional, local dev only: absolute path to a checked-out ProGrads-content. Gates the dev-only
# GET /coverage endpoint (content-repo build-out inventory); unset in every deployment.
# CONTENT_DIR="/path/to/ProGrads-content"
